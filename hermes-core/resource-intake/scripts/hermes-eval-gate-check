#!/usr/bin/env python3
"""Hermes Eval Gate evidence validator.

This file starts as a library for Task 2. Task 3 will add the command-line
interface and report-writing behavior.
"""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any


def load_schema(path: Path) -> dict[str, Any]:
    """Load the Hermes eval gate schema."""
    return json.loads(Path(path).read_text())


def required_gates_for(schema: dict[str, Any], resource_name: str) -> list[str]:
    """Return required gate IDs for a resource name from the schema."""
    for resource in schema.get("resources", []):
        if resource.get("name") == resource_name:
            return list(resource.get("required_gates", []))
    raise ValueError(f"unknown resource: {resource_name}")


def validate_evidence(schema: dict[str, Any], evidence: dict[str, Any]) -> dict[str, Any]:
    """Validate evidence against required gates for the resource.

    The validator intentionally does not inspect referenced report files yet.
    Task 3 and later report aggregation will add CLI and path handling.
    """
    resource_name = evidence.get("resource")
    target_state = evidence.get("target_state")
    if not resource_name:
        raise ValueError("evidence missing resource")
    if not target_state:
        raise ValueError("evidence missing target_state")

    required_gates = required_gates_for(schema, resource_name)
    provided_gates = evidence.get("gates") or {}
    missing_gates = [gate for gate in required_gates if gate not in provided_gates]
    failed_gates = [
        gate
        for gate in required_gates
        if gate in provided_gates and provided_gates[gate].get("status") != "pass"
    ]
    verdict = "pass" if not missing_gates and not failed_gates else "block"

    return {
        "resource": resource_name,
        "target_state": target_state,
        "required_gates": required_gates,
        "verdict": verdict,
        "missing_gates": missing_gates,
        "failed_gates": failed_gates,
    }
